# Worker build. Targets: build, test, clean (required by the root Makefile).

# CMake looks in $PATH-derived prefixes (like /opt/anaconda3) BEFORE Homebrew, and
# anaconda ships protobuf 3.20. Mixing its protoc with Homebrew's libprotobuf gives
# "generated by an older version of protoc" errors. CMakeLists.txt also puts the
# Homebrew prefix first; passing it here too makes the intent obvious.
BREW_PREFIX := $(shell brew --prefix 2>/dev/null)
CMAKE_ARGS  := $(if $(BREW_PREFIX),-DCMAKE_PREFIX_PATH=$(BREW_PREFIX),) $(EXTRA_CMAKE_ARGS)

.PHONY: build test clean

build:
	cmake -B build $(CMAKE_ARGS)
	cmake --build build -j

test: build
	ctest --test-dir build --output-on-failure

clean:
	rm -rf build
